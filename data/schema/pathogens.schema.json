{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathomap.local/schema/pathogens.schema.json",
  "title": "PathoMap pathogens dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "pathogens"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "dataset",
        "schema_version",
        "tables"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "built_at": {
          "type": "string"
        },
        "tables": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        }
      }
    },
    "pathogens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pathogen_id",
          "name",
          "genus",
          "species",
          "serovar",
          "strain",
          "tax_id",
          "ncbi_scientific_name",
          "family",
          "order_name",
          "class_name",
          "phylum",
          "gram_stain",
          "acid_fast",
          "strategy",
          "strategy_secondary",
          "strategy_evidence",
          "intracellular_niche",
          "genome_accession",
          "assembly_level",
          "genome_size_mb",
          "gc_content",
          "n_contigs",
          "reference_doi",
          "description",
          "curation_notes",
          "curation_status",
          "last_updated"
        ],
        "properties": {
          "pathogen_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "genus": {
            "type": "string",
            "minLength": 1
          },
          "species": {
            "type": "string",
            "minLength": 1
          },
          "serovar": {
            "type": [
              "string",
              "null"
            ]
          },
          "strain": {
            "type": [
              "string",
              "null"
            ]
          },
          "tax_id": {
            "type": "integer",
            "minimum": 1
          },
          "ncbi_scientific_name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "order_name": {
            "type": "string",
            "minLength": 1
          },
          "class_name": {
            "type": "string",
            "minLength": 1
          },
          "phylum": {
            "type": "string",
            "minLength": 1
          },
          "gram_stain": {
            "enum": [
              "Gram-positive",
              "Gram-negative",
              "Gram-variable",
              "unknown"
            ]
          },
          "acid_fast": {
            "type": "boolean"
          },
          "strategy": {
            "enum": [
              "arrest",
              "escape",
              "reroute",
              "modified_compartment",
              "extracellular",
              "unknown"
            ]
          },
          "strategy_secondary": {
            "type": [
              "string",
              "null"
            ]
          },
          "strategy_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "intracellular_niche": {
            "type": [
              "string",
              "null"
            ]
          },
          "genome_accession": {
            "type": [
              "string",
              "null"
            ]
          },
          "assembly_level": {
            "enum": [
              "Complete Genome",
              "Chromosome",
              "Scaffold",
              "Contig",
              "unknown"
            ]
          },
          "genome_size_mb": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.1,
            "maximum": 20
          },
          "gc_content": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 10,
            "maximum": 90
          },
          "n_contigs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reference_doi": {
            "type": "string",
            "pattern": "^10\\."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "curation_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "curation_status": {
            "enum": [
              "curated",
              "needs_review"
            ]
          },
          "last_updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
