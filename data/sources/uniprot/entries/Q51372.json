  "proteinDescription": {
    "recommendedName": {
      "fullName": {
        "value": "Alginate biosynthesis protein AlgX"
      }
    },
    "alternativeNames": [
      {
        "fullName": {
          "value": "Probable alginate O-acetyltransferase AlgX"
        },
        "ecNumbers": [
          {
            "value": "2.3.1.-"
          }
        ]
      }
    ],
