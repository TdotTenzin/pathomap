    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "36356582"
            }
          ],
          "value": "M.marinum contains the ancestral full-length version of EsxM rather than the truncated inactive version which is present in other modern Mtb lineages, including M.tuberculosis H37Rv (PubMed:36356582). Reconstitution of this ancestral version of EsxM in M.tuberculosis H37Rv alters the migratory mode of infected macrophages, enhancing their motility (PubMed:36356582)"
        }
      ],
