  "comments": [
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250"
            }
          ],
          "value": "Acts in concert with other proteins to mediate cellular responses leading to bacterial internalization. Activator for both CDC42 and RAC1 by directly engaging these Rho GTPases and acting as potent guanine nucleotide exchange factor (GEF). This activation results in actin cytoskeleton rearrangements and stimulates membrane ruffling, promoting bacterial entry into non-phagocytic cells (By similarity)"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "SUBCELLULAR LOCATION",
      "note": {
        "texts": [
          {
            "value": "Secreted via the type III secretion system 1 (SPI-1 T3SS)"
          }
        ]
      },
      "subcellularLocations": [
        {
          "location": {
            "value": "Secreted",
            "id": "SL-0243"
          }
        }
      ]
    },
    {
      "texts": [
        {
          "value": "Encoded within a lambda-like prophage region with similarity to GIFSY phages"
        }
      ],
      "commentType": "MISCELLANEOUS"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000305"
            }
          ],
          "value": "Belongs to the GEF (guanine exchange factor) SopE family"
        }
      ],
      "commentType": "SIMILARITY"
    }
