          ],
          "value": "Contains three domains: an N-terminal ATP-binding domain, a large central rifampicin (RIF)-binding domain and a small C-terminal swivel phosphohistidine domain that harbors the conserved histidine residue essential for phosphate transfer"
        }
      ],
