    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "34725337"
            }
          ],
          "value": "Part of the hemO gene cluster"
        }
      ],
      "commentType": "INDUCTION"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "34725337"
            }
          ],
          "value": "Contains an N-terminal clamp-like domain that binds heme and a C-terminal eight-stranded beta-barrel domain (PubMed:34725337). The loop containing His-42 undergoes a large conformational change upon heme binding and release (PubMed:34725337)"
        }
      ],
      "commentType": "DOMAIN"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "34725337"
            }
          ],
          "value": "In a mouse pulmonary infection model, the mutant shows a small decrease in bacterial lung burden and systemic spread"
        }
      ],
      "commentType": "DISRUPTION PHENOTYPE"
    }
