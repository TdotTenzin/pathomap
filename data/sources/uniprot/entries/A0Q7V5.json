  "comments": [
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "value": "Member of the two-component regulatory system BfpR/BfpK, which modulates biofilm production and antimicrobial peptide (AMP) resistance (PubMed:32232010). Controls, directly or indirectly, a broad range of genes (PubMed:32232010). Acts as a negative regulator of biofilm production and a positive regulator of antimicrobial peptide resistance (PubMed:32232010). BfpR also indirectly or directly negatively modulates expression of some Francisella Pathogenicity Island (FPI) genes such as iglC, which are necessary for intramacrophage replication and infection (PubMed:32232010). It binds to a specific palindromic DNA sequence (TGT-n8/9-TGT) in the promoter region of target genes, including iglA, glgC and acpA (PubMed:32232010)"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "commentType": "COFACTOR",
      "cofactors": [
        {
          "name": "Mg(2+)",
          "evidences": [
            {
              "evidenceCode": "ECO:0000305",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "cofactorCrossReference": {
            "database": "ChEBI",
            "id": "CHEBI:18420"
          }
        }
      ]
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000305",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "value": "Probably forms homodimers"
        }
      ],
      "commentType": "SUBUNIT"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000305",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "value": "Probably phosphorylated and activated by BfpR"
        }
      ],
      "commentType": "PTM"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "value": "The mutant shows increased biofilm formation, increased polysaccharide levels and intracellular glycogen, and increased susceptibility to antimicrobial peptides such as human cathelicidin peptide LL-37 and sheep antimicrobial peptide SMAP-29 (PubMed:32232010). Mutation does not affect susceptibility to cyclic peptide antibiotics such as polymyxin B, or to antibiotics in general, including streptomycin, ciprofloxacin and gentamicin (PubMed:32232010)"
        }
      ],
      "commentType": "DISRUPTION PHENOTYPE"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "32232010"
            }
          ],
          "value": "Overexpression affects expression of the critical Francisella virulence factor iglC, as well as other proteins, and decreases growth (PubMed:32232010). It inhibits intramacrophage replication and infection in the moth larvae insect model, Galleria mellonella (PubMed:32232010). High Mg(2+) concentrations relieve the growth suppression caused by overexpression of the protein (PubMed:32232010)"
        }
      ],
      "commentType": "MISCELLANEOUS"
    }
  ],
