    {
      "texts": [
        {
          "value": "Causative agent of the symptoms associated with scarlet fever, have been associated with streptococcal toxic shock-like disease and may play a role in the early events of rheumatic fever"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "texts": [
        {
          "value": "Binds to major histocompatibility complex class II beta chain"
        }
      ],
      "commentType": "MISCELLANEOUS"
    },
    {
      "texts": [
        {
          "value": "This toxin is coded by bacteriophage T12"
        }
      ],
      "commentType": "MISCELLANEOUS"
