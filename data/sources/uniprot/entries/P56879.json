              "id": "PRU00395"
            }
          ],
          "value": "Belongs to the cyclotide family. Bracelet subfamily"
        }
      ],
      "commentType": "SIMILARITY"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000305"
            }
          ],
          "value": "This peptide is cyclic. The start position was chosen by similarity to OAK1 (kalata-B1) for which the DNA sequence is known"
        }
      ],
