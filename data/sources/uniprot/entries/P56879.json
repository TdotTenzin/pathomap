  "comments": [
    {
      "texts": [
        {
          "value": "Probably participates in a plant defense mechanism. Has antibiotic activity. Inhibits the cytopathic effects and replication of the human immunodeficiency virus. Active against both Gram-positive and Gram-negative bacteria"
        }
      ],
      "commentType": "FUNCTION"
    },
    {
      "texts": [
        {
          "value": "The presence of a 'disulfide through disulfide knot' structurally defines this protein as a knottin"
        }
      ],
      "commentType": "DOMAIN"
    },
    {
      "texts": [
        {
          "value": "This is a cyclic peptide"
        }
      ],
      "commentType": "PTM"
    },
    {
      "commentType": "MASS SPECTROMETRY",
