  "comments": [
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000250",
              "source": "UniProtKB",
              "id": "B2RLK2"
            }
          ],
          "value": "Cysteine proteinase with a strong preference for substrates with Lys in the P1 position. Hydrolyzes bovine hemoglobin, bovine serum albumin, casein, human placental type I collagen and human IgA and IgG. Disrupts the functions of polymorphonuclear leukocytes. May act as a virulence factor in the development of peridontal disease. Involved in the coaggregation of P.gingivalis with other oral bacteria (By similarity)"
        }
      ],
      "commentType": "FUNCTION"
    },
