              "id": "12062101"
            }
          ],
          "value": "Interacts with human ARHA"
        }
      ],
      "commentType": "SUBUNIT"
    },
    {
      "commentType": "SUBCELLULAR LOCATION",
      "note": {
        "texts": [
          {
            "value": "In infected cells, it is cytoplasmic. Translocated into the host cell by the type III secretion apparatus with the help of the SycT chaperone"
          }
        ]
      },
