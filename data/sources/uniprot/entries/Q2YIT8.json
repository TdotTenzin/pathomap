              "source": "PubMed",
              "id": "10940027"
            }
          ],
          "value": "Transcription is turned on at the beginning of the stationary phase of vegetative growth"
        }
      ],
      "commentType": "DEVELOPMENTAL STAGE"
    },
    {
      "texts": [
        {
          "evidences": [
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "11988518"
            },
            {
              "evidenceCode": "ECO:0000269",
              "source": "PubMed",
              "id": "18469100"
            }
          ],
          "value": "Deletion of the gene significantly decreases the ability of B.abortus to survive inside mouse macrophage-like cells (PubMed:11988518, PubMed:18469100). The mutant shows decreased levels of VirB5, while VirB8, VirB9, VirB10, VirB11 and VirB12 are detected at wild-type levels (PubMed:18469100)"
        }
      ],
      "commentType": "DISRUPTION PHENOTYPE"
    },
    {
